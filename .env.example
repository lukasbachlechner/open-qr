# Path to the SQLite file. The Docker image hard-codes /data/openqr.db.
DATABASE_URL=./data/openqr.db

# When behind a reverse proxy that terminates TLS, set these so SvelteKit
# sees the user-facing protocol/host/IP and the Secure cookie flag is emitted.
# PROTOCOL_HEADER=x-forwarded-proto
# HOST_HEADER=x-forwarded-host
# ADDRESS_HEADER=x-forwarded-for

# Email — choose ONE provider. Leave both blank and OTP codes are logged to stdout.
#
# Option A: Resend (https://resend.com)
RESEND_API_KEY=
#
# Option B: SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
#
# "From" address used by whichever provider is active.
MAIL_FROM=

# Set to false before first startup if you do not want the first OTP user to
# become admin automatically.
OPENQR_AUTO_PROMOTE_FIRST_USER=true

# Optional URL reputation providers are configured in the admin panel.
# Google Web Risk requires an API key; URLhaus and PhishTank keys are optional
# depending on usage; Spamhaus DBL may require a datafeed/subscription for
# commercial or higher-volume deployments.

# Private deployment: hide marketing, require login for app pages/APIs,
# and restrict signup. Existing accounts retain access. QR scans stay public.
OPENQR_PRIVATE_MODE=false
# Required for first signup on a fresh private install; comma-separated emails.
OPENQR_ALLOWED_EMAILS=
